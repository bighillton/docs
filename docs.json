{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Docs",
  "colors": {
    "primary": "#1B1B2B",
    "light": "#2C2A40",
    "dark": "#FFFFFF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "overview/Introduction",
              "overview/Architecture",
              "overview/Quickstart"
            ]
          },
          {
            "group": "Trade",
            "pages": [
              "trade/Swap",
              "trade/Perpetuals",
              "trade/Stocks"
            ]
          },
          {
            "group": "Trading Bots",
            "pages": [
              "bots/Overview",
              "bots/Grid bot",
              "bots/DCA bot",
              "bots/Sniper bot"
            ]
          },
          {
            "group": "Earn",
            "pages": [
              "earn/Pools",
              "earn/Lend",
              "earn/Staking"
            ]
          },
          {
            "group": "Ecosystem & Rewards",
            "pages": [
              "ecosystem/Portfolio",
              "ecosystem/Referrals"
            ]
          },
          {
            "group": "Security & Reference",
            "pages": [
              "resources/Fees",
              "resources/Security Audits",
              "resources/FA"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.dyxy.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dyxyhq",
      "github": "https://github.com/dyxy-io",
      "telegram": "https://t.me/DYXY_Announcements"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "sdcdwcwcwdcw",
      "weight": 400
    },
    "body": {
      "family": "Inter",
      "weight": 200
    }
  },
  "background": {
    "decoration": "gradient"
  }
}
