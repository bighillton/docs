            "pages": [
              "bots/Overview",
              "bots/Grid bot",
              "bots/DCA bot",
              "bots/Sniper bot"
            ]
          },
          {
            "group": "Earn",
            "pages": [
              "earn/Pools",
              "earn/Lend",
              "earn/Staking"
            ]
          },
          {
            "group": "Ecosystem & Rewards",
            "pages": [
              "ecosystem/Portfolio",
              "ecosystem/Referrals"
            ]
          },
          {
            "group": "Security & Reference",
            "pages": [
              "resources/Fees",
              "resources/Security Audits",
              "resources/FAQ"
            ]
          }
        ]
      }
    ]
  }
}
