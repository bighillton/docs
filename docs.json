{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Docs",
  "colors": {
    "primary": "#8C7FFE",
    "light": "#8967FB",
    "dark": "#864FF8"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.dyxy.io"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dyxyhq",
      "github": "https://github.com/dyxy-io",
      "telegram": "https://t.me/DYXY_Announcements"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
