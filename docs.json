{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Platform Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#4ADE80",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "overview/introduction",
              "overview/architecture",
              "overview/quickstart"
            ]
          },
          {
            "group": "Trade",
            "pages": [
              "trade/swap",
              "trade/perpetuals",
              "trade/stocks"
            ]
          },
          {
            "group": "Trading Bots",
            "pages": [
              "bots/overview",
              "bots/grid-bot",
              "bots/dca-bot",
              "bots/combo-bot",
              "bots/sniper-bot"
            ]
          },
          {
            "group": "Earn Hub",
            "pages": [
              "earn/pools",
              "earn/lend",
              "earn/staking"
            ]
          },
          {
            "group": "Ecosystem & Rewards",
            "pages": [
              "ecosystem/portfolio",
              "ecosystem/referrals"
            ]
          },
          {
            "group": "Security & Reference",
            "pages": [
              "resources/fees",
              "resources/security-audits",
              "resources/faq"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.dyxy.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/dyxyhq",
      "github": "https://github.com/dyxy-io",
      "telegram": "https://t.me/DYXY_Announcements"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "heading": {
      "family": "sdcdwcwcwdcw",
      "weight": 400
    },
    "body": {
      "family": "Inter",
      "weight": 200
    }
  }
}
